# KinetOS debug config for x86_64
# slower but easier to debug

ARCH=x86_64
BOOT_PROTOCOL=multiboot2

# optimization
OPT_LEVEL=0
DEBUG_INFO=y
FRAME_POINTER=y
KASAN=y
UBSAN=y

# features
SCHED_RT=y
PREEMPT=y
HIGH_RES_TIMERS=y
SMP=n
MAX_CPUS=1

# memory
PAGE_SIZE=4096
HEAP_SIZE_MB=64

# debug
PANIC_ON_BUG=y
STACK_CANARY=y
SERIAL_DEBUG=y
VERBOSE_BOOT=y